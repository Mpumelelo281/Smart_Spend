# Base URL the frontend calls for the API — see src/api/client.js. Falls
# back to http://localhost:8000/api/v1 when unset, so this file is only
# needed when running the frontend outside docker-compose (which sets this
# directly as an `environment:` entry on the `frontend` service instead).
VITE_API_BASE_URL=http://localhost:8000/api/v1
