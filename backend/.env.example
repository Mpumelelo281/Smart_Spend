DJANGO_SECRET_KEY=change-me-in-every-environment
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://smartspend:smartspend@db:5432/smartspend
REPORTING_DATABASE_URL=postgres://smartspend_reporting:smartspend_reporting@db:5432/smartspend

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
PRICE_CACHE_URL=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:5173

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@smartspend.dut4life.ac.za
FRONTEND_BASE_URL=http://localhost:5173

BUDGET_ALERT_THRESHOLD_PCT=80
K_ANONYMITY_THRESHOLD=10
MFA_ISSUER_NAME=SmartSpend
EMAIL_VERIFICATION_ALLOWED_DOMAINS=dut4life.ac.za,dut.ac.za
PRE_AUTH_TOKEN_MAX_AGE_SECONDS=300
SECURE_SSL_REDIRECT=False

# --- Local-testing-only escape hatches. NEVER set these outside a ---
# --- developer's own machine — see the comments where each is used. ---
# CACHE_BACKEND=locmem   # skip Redis entirely (breaks Rule 4's shared cache)
# ENFORCE_EMAIL_DOMAIN_RESTRICTION=False   # accept any email at registration
# SKIP_AUTH_VERIFICATION_FOR_TESTING=True   # auto-verify email, skip TOTP MFA
CACHE_BACKEND=redis
ENFORCE_EMAIL_DOMAIN_RESTRICTION=True
SKIP_AUTH_VERIFICATION_FOR_TESTING=False
